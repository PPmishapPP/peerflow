# Пример окружения для деплоя PeerFlow.
# Скопируйте в .env рядом с compose.prod.yaml и подставьте свои значения.
# Файл .env в git не попадает и содержит секреты.

# --- База данных ---
POSTGRES_DB=peerflow
POSTGRES_USER=peerflow
# Придумайте длинный случайный пароль.
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
# Ключ подписи JWT, минимум 32 символа. Сгенерировать:
#   openssl rand -base64 48
PEERFLOW_JWT_SECRET=change-me-32-plus-random-characters

# Каталог вложений на хосте (аватары). По умолчанию ./storage рядом с compose.
PEERFLOW_STORAGE_DIR=./storage

# JDBC-URL по умолчанию указывает на сервис postgres внутри стека — менять не нужно.
# PEERFLOW_DB_URL=jdbc:postgresql://postgres:5432/peerflow
