# Контекст сборки образа сервера. Всё, что не нужно внутри — не отправляем.

# Локальные настройки сборки (путь к JDK конкретной машины) — в контейнере
# неверны и мешают сборке.
gradle.properties

# Сборочный мусор и результаты предыдущих сборок
build/
.gradle/
.kotlin/
out/

# Данные и локальная конфигурация
storage/
src/main/resources/application-local.yml
# Секреты деплоя: в контекст сборки им попадать незачем.
.env
.env.*

# README и черновики в образ не нужны
README.md

# Служебное
.git/
.gitignore
.idea/
*.iml

# Тесты не нужны для сборки рантайм-образа
src/test/
